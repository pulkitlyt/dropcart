PORT=8000
NODE_ENV=development

# Atlas connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Dropcart

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175
