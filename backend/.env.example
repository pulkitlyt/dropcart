PORT=8000
NODE_ENV=development

# Atlas connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Dropcart

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Optional. When unset or unreachable, flash-sale checkout falls back to the
# mongo-atomic path, which is correct on its own.
# Local:  redis://127.0.0.1:6379
# Upstash: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=

# Image uploads. Without these, upload endpoints return 503 and the seller
# forms fall back to pasting image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dropcart
